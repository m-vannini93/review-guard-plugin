{
    "hooks": {
        "SessionStart": [{
            "matcher": "startup",
            "hooks": [{
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/check_gitignore.py"
            }]
        }],
        "PreToolUse": [
            {
                "matcher": "Read|Edit|Write|Bash|Grep",
                "hooks": [{
                    "type": "command",
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/protect_env.py"
                }]
            },
            {
                "matcher": "Bash",
                "hooks": [{
                    "type": "command",
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard_git.py"
                }]
            }
        ]
    }
}
